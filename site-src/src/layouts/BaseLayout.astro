---
import "../styles/global.css";
import { absoluteUrl, basePath, localizedPaths, pageMeta, pathFor, type Language } from "../data/siteMeta";

interface Props {
  lang: Language;
  page: keyof typeof localizedPaths;
}

const { lang, page } = Astro.props;
const meta = pageMeta[page][lang];
const canonicalPath = localizedPaths[page][lang];
const canonicalUrl = absoluteUrl(canonicalPath);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(localizedPaths[page].en)} />
    <link rel="alternate" hreflang="ru" href={absoluteUrl(localizedPaths[page].ru)} />
    <link rel="alternate" hreflang="es" href={absoluteUrl(localizedPaths[page].es)} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizedPaths[page].en)} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" href={pathFor("/assets/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={pathFor("/favicon.ico")} sizes="any" />
    <link rel="icon" href={pathFor("/assets/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={pathFor("/assets/apple-touch-icon.png")} />
    <link rel="manifest" href={pathFor("/site.webmanifest")} />
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ basePath }}>
      document.querySelectorAll(".lang-switch a").forEach((link) => {
        link.addEventListener("click", (event) => {
          const href = link.getAttribute("href");
          if (!href || href.startsWith("http")) return;
          event.preventDefault();
          window.location.href = href + (window.location.hash || "");
        });
      });
      window.CRS_BASE_PATH = basePath;
    </script>
  </body>
</html>

