---
import "../styles/global.css";
import {
  absoluteUrl,
  basePath,
  defaultImage,
  githubBlob,
  languages,
  localizedPaths,
  ogLocales,
  pageMeta,
  pathFor,
  repoUrl,
  siteName,
  siteUrl,
  themeColor,
  type Language
} from "../data/siteMeta";
import content from "../data/site-content.json";
import registry from "../data/registry.json";

interface Props {
  lang: Language;
  page: keyof typeof localizedPaths;
}

const { lang, page } = Astro.props;
const meta = pageMeta[page][lang];
const canonicalPath = localizedPaths[page][lang];
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(defaultImage.path);
const imageAlt = defaultImage.alt[lang];
const alternateOgLocales = languages.filter((language) => language !== lang).map((language) => ogLocales[language]);
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || "";
const hasGoogleAnalytics = /^G-[A-Z0-9]+$/.test(gaMeasurementId);
const languageStorageKey = "civil-resistance-skills:language";
const localizedContent = content as Record<string, any>;
const registryData = registry as any;
const pageContent = localizedContent[lang][page];
const domainLabels = localizedContent[lang].common.domains as Record<string, { label: string; description: string }>;
const faqItems = (pageContent.faq?.items ?? []) as Array<{ question: string; answer: string }>;
const faqGraph = faqItems.length
  ? [
      {
        "@type": "FAQPage",
        "@id": `${canonicalUrl}#faq`,
        url: canonicalUrl,
        inLanguage: lang,
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer
          }
        }))
      }
    ]
  : [];
const homeSchema = (localizedContent[lang].home as any).schema as { domainsListName: string; atlasName: string; atlasDescription: string };
const communicationSchema = (localizedContent[lang].communication as any).schema as { appliedSkillsListName: string };
const itemListGraph =
  page === "home"
    ? [
        {
          "@type": "ItemList",
          "@id": `${canonicalUrl}#domains`,
          name: homeSchema.domainsListName,
          numberOfItems: registryData.domains.length,
          itemListElement: registryData.domains.map((domain: { key: string }, index: number) => ({
            "@type": "ListItem",
            position: index + 1,
            name: domainLabels[domain.key].label,
            description: domainLabels[domain.key].description
          }))
        }
      ]
    : [
        {
          "@type": "ItemList",
          "@id": `${canonicalUrl}#applied-skills`,
          name: communicationSchema.appliedSkillsListName,
          numberOfItems: pageContent.operational.skills.length,
          itemListElement: pageContent.operational.skills.map((skill: { id: string; title: string; body: string }, index: number) => ({
            "@type": "ListItem",
            position: index + 1,
            name: skill.title,
            url: githubBlob(`skills-catalog/${skill.id}/SKILL.md`),
            description: skill.body
          }))
        }
      ];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      name: siteName,
      url: siteUrl,
      inLanguage: languages,
      description: pageMeta.home.en.description,
      publisher: {
        "@id": `${siteUrl}/#project`
      }
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#project`,
      name: siteName,
      url: siteUrl,
      sameAs: [repoUrl]
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: meta.title,
      description: meta.description,
      isPartOf: {
        "@id": `${siteUrl}/#website`
      },
      inLanguage: lang,
      image: imageUrl,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: imageUrl,
        width: defaultImage.width,
        height: defaultImage.height,
        caption: imageAlt
      }
    },
    {
      "@type": "CreativeWork",
      "@id": `${siteUrl}/#atlas`,
      name: homeSchema.atlasName,
      url: siteUrl,
      description: homeSchema.atlasDescription,
      isPartOf: {
        "@id": `${siteUrl}/#website`
      },
      inLanguage: languages,
      license: githubBlob("LICENSE")
    },
    ...faqGraph,
    ...itemListGraph
  ]
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    {languages.map((language) => <link rel="alternate" hreflang={language} href={absoluteUrl(localizedPaths[page][language])} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizedPaths[page].en)} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {alternateOgLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content={defaultImage.type} />
    <meta property="og:image:width" content={String(defaultImage.width)} />
    <meta property="og:image:height" content={String(defaultImage.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href={pathFor("/assets/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={pathFor("/favicon.ico")} sizes="any" />
    <link rel="icon" href={pathFor("/assets/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={pathFor("/assets/apple-touch-icon.png")} />
    <link rel="manifest" href={pathFor("/site.webmanifest")} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {hasGoogleAnalytics && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ basePath, languageStorageKey, lang }}>
      document.querySelectorAll("[data-language-switch]").forEach((select) => {
        try {
          localStorage.setItem(languageStorageKey, lang);
        } catch {}

        select.addEventListener("change", (event) => {
          const target = event.currentTarget;
          if (!(target instanceof HTMLSelectElement)) return;
          const href = target.value;
          if (!href || href.startsWith("http")) return;
          try {
            const selectedOption = target.selectedOptions[0];
            if (selectedOption) localStorage.setItem(languageStorageKey, selectedOption.dataset.language || "");
          } catch {}
          window.location.href = href + (window.location.hash || "");
        });
      });
      window.CRS_BASE_PATH = basePath;
    </script>
  </body>
</html>
