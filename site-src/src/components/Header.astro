---
import LanguageSwitch from "./LanguageSwitch.astro";
import { pathFor, repoUrl, type Language } from "../data/siteMeta";

interface Props {
  current: Language;
  page: "home" | "communication";
  nav: Record<string, string>;
  brand: string;
  github: string;
  primaryAria: string;
  languageAria: string;
}

const { current, page, nav, brand, github, primaryAria, languageAria } = Astro.props;
const homeHref = pathFor(current === "en" ? "/" : `/${current}/`);
const pageLinks =
  page === "home"
    ? [
        ["#why", nav.why],
        ["#install", nav.install],
        ["#domains", nav.domains],
        ["#catalog", nav.catalog]
      ]
    : [
        ["#operational", nav.operational],
        ["#registry", nav.registry]
      ];
---

<header class="topbar">
  <nav class="wrap nav" aria-label={primaryAria}>
    <a class="brand" href={homeHref}>
      <img src={pathFor("/assets/logo-wordmark.svg")} alt={brand} width="820" height="160" />
    </a>
    <div class="nav-right">
      <div class="links">
        {pageLinks.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href={repoUrl}>{github}</a>
      </div>
      <LanguageSwitch current={current} page={page} ariaLabel={languageAria} />
    </div>
  </nav>
</header>
