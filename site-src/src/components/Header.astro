---
import LanguageSwitch from "./LanguageSwitch.astro";
import { pathFor, repoUrl, type Language, type SectionKey, type SectionNavLink } from "../data/siteMeta";

interface Props {
  current: Language;
  page: "home" | "communication";
  active?: SectionKey;
  sections: SectionNavLink[];
  brand: string;
  github: string;
  primaryAria: string;
  languageAria: string;
}

const { current, page, active, sections, brand, github, primaryAria, languageAria } = Astro.props;
const homeHref = pathFor(current === "en" ? "/" : `/${current}/`);
---

<header class="topbar">
  <nav class="wrap nav" aria-label={primaryAria}>
    <a class="brand" href={homeHref}>
      <img src={pathFor("/assets/logo-wordmark.svg")} alt={brand} width="820" height="160" />
    </a>
    <div class="nav-right">
      <div class="links">
        {sections.map((link) => (
          <a
            href={link.href}
            aria-current={active === link.key ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
        <a href={repoUrl}>{github}</a>
      </div>
      <LanguageSwitch current={current} page={page} ariaLabel={languageAria} />
    </div>
  </nav>
</header>
