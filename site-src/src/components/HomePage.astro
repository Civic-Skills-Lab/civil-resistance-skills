---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import CopyButton from "./CopyButton";
import content from "../data/site-content.json";
import registry from "../data/registry.json";
import {
  githubBlob,
  localizedPaths,
  pathFor,
  repoUrl,
  sectionsFor,
  type Language,
  type SectionKey
} from "../data/siteMeta";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const page = content[lang].home;
const common = content[lang].common;
const sections = sectionsFor(lang, common.sections);
const safetyHref = githubBlob("SAFETY.md");
const sourcesHref = githubBlob("methods-registry/03-sources-and-references.md");
const claudeCommand = "/plugin marketplace add Civic-Skills-Lab/civil-resistance-skills\n/plugin install civil-resistance-communication@civil-resistance-skills-marketplace";
const codexCommand = "codex plugin marketplace add Civic-Skills-Lab/civil-resistance-skills\ncodex\n/plugins";
const exploreCardOrder: SectionKey[] = ["methods", "domains", "skills", "organizations"];
const methodsHref = pathFor(localizedPaths.methods[lang]);
const domainLabels = common.domains as Record<string, { label: string; description: string }>;
---

<BaseLayout lang={lang} page="home">
  <Header
    current={lang}
    page="home"
    sections={sections}
    brand={common.brand}
    github={common.github}
    primaryAria={common.aria.primary}
    languageAria={common.aria.language}
  />
  <main>
    <section class="hero">
      <div class="wrap">
        <div class="eyebrow">{page.hero.eyebrow}</div>
        <h1>{page.hero.title}</h1>
        <p class="lead">{page.hero.lead}</p>
        <div class="boundary">{page.hero.boundary}</div>
        <div class="actions">
          <a class="button primary" href={methodsHref}>{page.hero.actions.browse}</a>
          <a class="button" href={pathFor(localizedPaths.skills[lang])}>{page.hero.actions.operational}</a>
          <a class="button" href={repoUrl}>{page.hero.actions.repo}</a>
          <a class="button" href={safetyHref}>{page.hero.actions.safety}</a>
        </div>
        <div class="stats" aria-label={common.aria.registryStats}>
          <div class="stat"><div class="num">{registry.stats.methods}</div><div class="label">{page.hero.stats[0]}</div></div>
          <div class="stat"><div class="num">{registry.stats.domains}</div><div class="label">{page.hero.stats[1]}</div></div>
          <div class="stat"><div class="num">{registry.stats.operational}</div><div class="label">{page.hero.stats[2]}</div></div>
          <div class="stat"><div class="num">{registry.stats.highRisk}</div><div class="label">{page.hero.stats[3]}</div></div>
        </div>
      </div>
    </section>

    <section class="visual-band" aria-label={common.aria.atlasPreview}>
      <div class="wrap">
        <div class="atlas-panel">
          <h2>{common.brand}</h2>
          <p class="atlas-kicker">{page.atlas.kicker}</p>
          <div class="atlas-domains" aria-label={common.aria.domainCounts}>
            {registry.domains.map((domain) => (
              <div class="atlas-domain">
                <span>{page.atlas.domainWord} {domain.code}</span>
                <strong>{domainLabels[domain.key].label}</strong>
                <em>{domain.count} {page.atlas.recordWord}</em>
              </div>
            ))}
          </div>
          <div class="atlas-notes">
            {page.atlas.notes.map((note) => (
              <div class={`atlas-note ${note.kind}`}>
                <strong>{note.title}</strong>
                <p>{note.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="explore" aria-labelledby="explore-heading">
      <div class="wrap">
        <div class="section-head"><div><h2 id="explore-heading">{page.explore.title}</h2><p class="section-copy">{page.explore.body}</p></div></div>
        <div class="callout explore-grid">
          {exploreCardOrder.map((key) => {
            const card = page.explore.cards[key];
            const href = pathFor(localizedPaths[key][lang]);
            return (
              <article class="card explore-card">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
                <p class="card-action"><a href={href}>{card.action}</a></p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section id="why">
      <div class="wrap">
        <div class="section-head"><div><h2>{page.why.title}</h2><p class="section-copy">{page.why.body}</p></div></div>
        <div class="callout">
          {page.why.cards.map((card) => <article class="card"><h3>{card.title}</h3><p>{card.body}</p></article>)}
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section">
      <div class="wrap">
        <div class="section-head"><div><h2>{page.faq.title}</h2><p class="section-copy">{page.faq.body}</p></div></div>
        <div class="faq-list">
          {page.faq.items.map((item) => (
            <article class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="install">
      <div class="wrap">
        <div class="section-head"><div><h2>{page.install.title}</h2><p class="section-copy">{page.install.body}</p></div></div>
        <div class="install-grid">
          <article class="card install">
            <h3>Claude Code</h3>
            <p>{page.install.claudeBody}</p>
            <CopyButton client:load command={claudeCommand} html={"/plugin marketplace add Civic-Skills-Lab/civil-resistance-skills<br>/plugin install civil-resistance-communication@civil-resistance-skills-marketplace"} copyLabel={common.copy} copiedLabel={common.copied} />
          </article>
          <article class="card install">
            <h3>Codex</h3>
            <p>{page.install.codexBody}</p>
            <CopyButton client:load command={codexCommand} html={"codex plugin marketplace add Civic-Skills-Lab/civil-resistance-skills<br>codex<br>/plugins"} copyLabel={common.copy} copiedLabel={common.copied} />
          </article>
        </div>
      </div>
    </section>
  </main>
  <footer><div class="wrap"><span>{page.footer.text}</span><span><a href={repoUrl}>{common.github}</a> - <a href={sourcesHref}>{page.footer.sources}</a></span></div></footer>
</BaseLayout>
