---
import { langNames, localizedPaths, pathFor, type Language } from "../data/siteMeta";

interface Props {
  current: Language;
  page: keyof typeof localizedPaths;
}

const { current, page } = Astro.props;
---

<div class="lang-switch" aria-label="Language">
  {(Object.keys(langNames) as Language[]).map((language) => (
    <a href={pathFor(localizedPaths[page][language])} aria-current={language === current ? "true" : undefined}>
      {langNames[language]}
    </a>
  ))}
</div>

