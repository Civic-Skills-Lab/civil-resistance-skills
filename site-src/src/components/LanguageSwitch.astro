---
import { languages, localizedPaths, pathFor, type Language } from "../data/siteMeta";

interface Props {
  current: Language;
  page: keyof typeof localizedPaths;
  ariaLabel: string;
}

const { current, page, ariaLabel } = Astro.props;
---

<select class="lang-switch" data-language-switch aria-label={ariaLabel}>
  {languages.map((language) => (
    <option value={pathFor(localizedPaths[page][language])} data-language={language} selected={language === current}>
      {language.toUpperCase()}
    </option>
  ))}
</select>
