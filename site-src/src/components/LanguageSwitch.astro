---
import { languages, langNames, localizedPaths, pathFor, type Language } from "../data/siteMeta";

interface Props {
  current: Language;
  page: keyof typeof localizedPaths;
}

const { current, page } = Astro.props;
---

<label class="lang-switch" aria-label="Language">
  <span>Language</span>
  <select data-language-switch aria-label="Language">
    {languages.map((language) => (
      <option value={pathFor(localizedPaths[page][language])} data-language={language} selected={language === current}>
        {langNames[language]}
      </option>
    ))}
  </select>
</label>
